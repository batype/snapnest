{
  "name": "@batype/snapnest",
  "version": "1.2.0",
  "description": "Local screenshot beautifier with solid redaction: a private-by-design web app, Node.js API and CLI.",
  "type": "module",
  "license": "MIT",
  "main": "./node/index.mjs",
  "types": "./node/index.d.ts",
  "exports": {
    ".": {
      "types": "./node/index.d.ts",
      "import": "./node/index.mjs"
    },
    "./core": "./dist/core.mjs"
  },
  "bin": {
    "snapnest": "./bin/snapnest.mjs"
  },
  "files": [
    "node/",
    "bin/",
    "dist/core.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:web": "node --test tests/core.test.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "node --check node/index.mjs && node --check bin/snapnest.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batype/snapnest.git"
  },
  "homepage": "https://batype.github.io/snapnest/",
  "bugs": {
    "url": "https://github.com/batype/snapnest/issues"
  },
  "keywords": [
    "screenshot",
    "beautifier",
    "redaction",
    "cli",
    "canvas",
    "privacy"
  ]
}
